#include <limits.h> 
#include <stdio.h>
#define MAX 20
int V, E;
int graph[MAX][MAX];
#define INFINITY 99999

void dijkstra(int G[MAX][MAX], int n, int startnode) {
	int distance[MAX];
	int pred[MAX];
	int visited[MAX];
	int count, mindistance, nextnode, i, j;

	for (i = 1; i <= n; i++) {
		if (i == startnode) {
			distance[i] = 0;
		} else if (G[startnode][i] == 0) {
			distance[i] = INFINITY;
		} else {
			distance[i] = G[startnode][i];
		}
		pred[i] = startnode;
		visited[i] = 0;
	}

	visited[startnode] = 1;
	count = 1;

	while (count < n) {
		mindistance = INFINITY;
		nextnode = startnode;
		for (i = 1; i <= n; i++) {
			if (distance[i] < mindistance && !visited[i]) {
				mindistance = distance[i];
				nextnode = i;
			}
} 
